---
import type { LegalPageContent } from '../data/legal';
import { getUI } from '../i18n/ui';
import type { Locale } from '../data/site';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  locale: Locale;
  content: LegalPageContent;
}

const { locale, content } = Astro.props;
const t = getUI(locale);
---

<article>
  <div class="border-b border-line">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs locale={locale} items={[{ name: content.h1 }]} />
      <h1 class="text-balance max-w-[22ch] text-4xl font-bold sm:text-5xl">{content.h1}</h1>
      <p class="mt-3 text-sm text-muted">
        {t.common.lastUpdated}: {content.updated}
      </p>
    </div>
  </div>

  <div class="container-wide py-14 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div class="rich-text">
        <p>{content.intro}</p>
        {
          content.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {
                section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))
              }
              {
                section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )
              }
            </section>
          ))
        }
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="rounded-[18px] border border-accent/30 bg-surface p-6">
          <h2 class="text-sm font-semibold uppercase tracking-wider text-accent">Review required</h2>
          <p class="mt-3 text-sm text-muted-strong">{content.reviewNote}</p>
        </div>
      </aside>
    </div>
  </div>
</article>
