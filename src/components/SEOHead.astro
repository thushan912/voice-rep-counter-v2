---
import { SITE, OG_IMAGE, type ImageAsset, type Locale } from '../data/site';
import { absoluteUrl, defaultHreflang, localizedPath, type HreflangAlternate } from '../i18n/routes';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  image?: ImageAsset;
  noindex?: boolean;
  article?: { publishedTime?: string; modifiedTime?: string };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  hreflang?: HreflangAlternate[];
  xDefault?: string;
}

const {
  locale,
  title,
  description,
  path,
  image,
  noindex = false,
  article,
  jsonLd,
  hreflang,
  xDefault,
} = Astro.props;

const og = image ?? OG_IMAGE;
const canonical = absoluteUrl(path);
const ogType = article?.publishedTime ? 'article' : 'website';
const alternates = hreflang ?? defaultHreflang(path);
const xDefaultHref = xDefault ?? absoluteUrl(localizedPath(path, 'en'));
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ogLocale = locale === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlternate = locale === 'it' ? 'en_US' : 'it_IT';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  noindex && (
    <meta name="robots" content="noindex,nofollow" />
  )
}

{
  alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteUrl(og.src)} />
<meta property="og:image:width" content={String(og.width)} />
<meta property="og:image:height" content={String(og.height)} />
<meta property="og:image:alt" content={og.alt} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteUrl(og.src)} />

{
  article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />
}
{
  article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />
}

{
  jsonLdList.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))
}
