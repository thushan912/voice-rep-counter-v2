---
import { exercises, type ExerciseSlug } from '../data/exercises';
import { type Locale } from '../data/site';
import { getUI } from '../i18n/ui';
import { localizedPath } from '../i18n/routes';
import Breadcrumbs from './Breadcrumbs.astro';
import FAQList from './FAQList.astro';
import FinalCTA from './FinalCTA.astro';

interface Props {
  locale: Locale;
  slug: ExerciseSlug;
}

const { locale, slug } = Astro.props;
const t = getUI(locale);
const exercise = exercises[locale][slug];
const exercisesPath = localizedPath('/exercises/', locale);
---

<article>
  <div class="border-b border-line">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs
        locale={locale}
        items={[
          { name: t.nav.exercises, href: exercisesPath },
          { name: exercise.navLabel },
        ]}
      />
      <h1 class="text-balance max-w-[22ch] text-4xl font-bold sm:text-5xl">{exercise.h1}</h1>
      <p class="mt-6 max-w-[64ch] text-lg text-muted-strong">{exercise.lead}</p>
    </div>
  </div>

  <div class="container-wide py-14 sm:py-20">
    <div class="grid gap-14 lg:grid-cols-[1.6fr_1fr]">
      <div class="space-y-14">
        <section>
          <h2 class="text-2xl font-bold sm:text-3xl">{exercise.why.heading}</h2>
          <div class="mt-4 grid gap-4 text-lg text-muted-strong">
            {exercise.why.body.map((paragraph) => <p class="max-w-[70ch]">{paragraph}</p>)}
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-bold sm:text-3xl">{exercise.example.heading}</h2>
          <div class="mt-4 grid gap-4 text-lg text-muted-strong">
            {exercise.example.body.map((paragraph) => <p class="max-w-[70ch]">{paragraph}</p>)}
          </div>
        </section>
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        <section class="card p-7">
          <h2 class="text-xl font-semibold">{exercise.clarify.heading}</h2>
          <div class="mt-4 grid gap-3 text-muted-strong">
            {exercise.clarify.body.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="card p-7">
          <h2 class="text-lg font-semibold">{t.common.relatedPages}</h2>
          <ul class="mt-4 grid gap-2">
            {
              exercise.related.map((related) => (
                <li>
                  <a
                    href={localizedPath(related.href, locale)}
                    class="font-semibold text-accent transition-colors hover:text-accent-strong"
                  >
                    {related.label} →
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>

    <section class="mt-20">
      <h2 class="text-2xl font-bold sm:text-3xl">{t.nav.faq}</h2>
      <div class="mt-8 max-w-[820px]">
        <FAQList items={exercise.faqs} />
      </div>
    </section>
  </div>
</article>

<FinalCTA locale={locale} />
