---
import { featureOrder, features, featuresOverview } from '../data/features';
import { IMAGES, type Locale } from '../data/site';
import { localizedPath } from '../i18n/routes';
import Breadcrumbs from './Breadcrumbs.astro';
import FinalCTA from './FinalCTA.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const overview = featuresOverview[locale];

const featureImages = {
  voiceRepCounting: IMAGES.voiceRepCounting,
  restTimer: IMAGES.restTimer,
  customSessions: IMAGES.customSessions,
  sequentialWorkouts: IMAGES.sequentialWorkouts,
} as const;
---

<article>
  <div class="border-b border-line">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs locale={locale} items={[{ name: overview.h1 }]} />
      <h1 class="text-balance max-w-[22ch] text-4xl font-bold sm:text-5xl">{overview.h1}</h1>
      <p class="mt-6 max-w-[64ch] text-lg text-muted-strong">{overview.lead}</p>
    </div>
  </div>

  <div class="container-wide py-14 sm:py-20">
    <div class="grid gap-4 md:grid-cols-2">
      {
        featureOrder.map((slug, index) => {
          const feature = features[locale][slug];
          const image = feature.image ? featureImages[feature.image] : null;
          return (
            <a
              href={localizedPath(`/features/${slug}/`, locale)}
              class="card group grid grid-cols-[128px_1fr] overflow-hidden transition-colors hover:border-accent sm:grid-cols-[170px_1fr]"
            >
              <div class="relative min-h-[150px] overflow-hidden bg-surface-raised sm:min-h-[170px]">
                {
                  image ? (
                    <img
                      src={image.src}
                      alt=""
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(120%_120%_at_50%_0%,rgba(200,245,0,0.14),transparent_60%)]">
                      <span class="font-display text-4xl font-bold text-accent/35">{String(index + 1).padStart(2, '0')}</span>
                    </div>
                  )
                }
              </div>

              <div class="flex flex-col justify-center p-6">
                <h2 class="text-xl font-semibold text-ink transition-colors group-hover:text-accent">
                  {feature.navLabel}
                </h2>
                <p class="mt-2 text-muted-strong">{feature.cardDescription}</p>
                <span class="mt-4 inline-flex items-center gap-2 font-semibold text-accent">
                  <span class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</article>

<FinalCTA locale={locale} />
