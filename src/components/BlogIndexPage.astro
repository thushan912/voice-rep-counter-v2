---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/site';
import { localizedPath } from '../i18n/routes';
import { formatDate } from '../utils/formatDate';
import Breadcrumbs from './Breadcrumbs.astro';
import FinalCTA from './FinalCTA.astro';

interface Props {
  locale: Locale;
  h1: string;
  lead: string;
  posts: { slug: string; data: CollectionEntry<'blog'>['data'] }[];
}

const { locale, h1, lead, posts } = Astro.props;
---

<article>
  <div class="border-b border-line">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs locale={locale} items={[{ name: h1 }]} />
      <h1 class="text-balance max-w-[22ch] text-4xl font-bold sm:text-5xl">{h1}</h1>
      <p class="mt-6 max-w-[64ch] text-lg text-muted-strong">{lead}</p>
    </div>
  </div>

  <div class="container-wide py-14 sm:py-20">
    <div class="grid gap-4 md:grid-cols-2">
      {
        posts.map((post) => (
          <a
            href={localizedPath(`/blog/${post.slug}/`, locale)}
            class="card group flex flex-col p-7 transition-colors hover:border-accent"
          >
            <p class="eyebrow">{post.data.category}</p>
            <h2 class="mt-3 text-xl font-semibold text-ink transition-colors group-hover:text-accent">
              {post.data.title}
            </h2>
            <p class="mt-3 flex-1 text-muted-strong">{post.data.description}</p>
            <div class="mt-5 flex items-center gap-2 text-sm text-muted">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
              <span aria-hidden="true">·</span>
              <span class="font-semibold text-accent">→</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</article>

<FinalCTA locale={locale} />
