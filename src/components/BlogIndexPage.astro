---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../data/site';
import { localizedPath } from '../i18n/routes';
import { formatDate } from '../utils/formatDate';
import Breadcrumbs from './Breadcrumbs.astro';
import FinalCTA from './FinalCTA.astro';

interface Props {
  locale: Locale;
  h1: string;
  lead: string;
  posts: { slug: string; data: CollectionEntry<'blog'>['data'] }[];
}

const { locale, h1, lead, posts } = Astro.props;

// Editorial thumbnails keyed by post slug, so every blog card shows an image.
const blogImages: Record<string, string> = {
  'how-to-pace-push-ups-with-a-spoken-count': '/assets/images/Push-up-voice-pace.webp',
  'how-long-to-rest-between-workout-sets': '/assets/images/Rest-between-sets.webp',
  'bodyweight-circuit-rep-rest-timers': '/assets/images/Custom-Workout-Sessions.webp',
  'voice-rep-timer-vs-automatic-rep-detection': '/assets/blog/Voice%20rep%20timer-vs-automatic-rep-detection.webp',
  'come-scandire-i-piegamenti-con-un-conteggio-vocale': '/assets/images/Push-up-voice-pace.webp',
  'timer-vocale-vs-rilevamento-automatico': '/assets/images/Voice-Rep-Counting.webp',
};
---

<article>
  <div class="border-b border-line">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs locale={locale} items={[{ name: h1 }]} />
      <h1 class="text-balance text-center text-4xl font-bold sm:text-5xl">{h1}</h1>
      <p class="mt-6 text-center text-lg text-muted-strong">{lead}</p>
    </div>
  </div>

  <div class="container-wide py-14 sm:py-20">
    <div class="grid gap-4 md:grid-cols-2">
      {
        posts.map((post) => {
          const heroImage = blogImages[post.slug] ?? post.data.heroImage;
          return (
            <a
              href={localizedPath(`/blog/${post.slug}/`, locale)}
              class="card group grid grid-cols-[128px_1fr] overflow-hidden transition-colors hover:border-accent sm:grid-cols-[170px_1fr]"
            >
              <div class="relative min-h-[150px] overflow-hidden bg-surface-raised sm:min-h-[170px]">
                {
                  heroImage ? (
                    <img
                      src={heroImage}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-[radial-gradient(120%_120%_at_50%_0%,rgba(200,245,0,0.14),transparent_60%)]">
                      <span class="font-display text-4xl font-bold text-accent/35">✦</span>
                    </div>
                  )
                }
              </div>

              <div class="flex flex-col justify-center p-6">
                <p class="eyebrow">{post.data.category}</p>
                <h2 class="mt-2 text-xl font-semibold text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-muted-strong">{post.data.description}</p>
                <div class="mt-4 flex items-center gap-2 text-sm text-muted">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
                  <span aria-hidden="true">·</span>
                  <span class="font-semibold text-accent">→</span>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</article>

<FinalCTA locale={locale} />
