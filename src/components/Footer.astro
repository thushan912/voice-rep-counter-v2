---
import { getUI } from '../i18n/ui';
import { localizedPath, homePath } from '../i18n/routes';
import { SITE, type Locale } from '../data/site';
import StoreBadges from './StoreBadges.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUI(locale);
const year = new Date().getFullYear();

const groups = [
  {
    title: t.footer.productTitle,
    links: [
      { label: t.footer.features, href: localizedPath('/features/', locale) },
      { label: t.footer.howItWorks, href: localizedPath('/how-it-works/', locale) },
      { label: t.footer.exercises, href: localizedPath('/exercises/', locale) },
      { label: t.footer.blog, href: localizedPath('/blog/', locale) },
    ],
  },
  {
    title: t.footer.guidesTitle,
    links: [
      { label: 'Push-ups', href: localizedPath('/exercises/push-up-rep-pacer/', locale) },
      { label: 'Squats', href: localizedPath('/exercises/squat-rep-timer/', locale) },
      { label: 'Plank', href: localizedPath('/exercises/plank-timer/', locale) },
    ],
  },
  {
    title: t.footer.supportTitle,
    links: [
      { label: t.footer.faq, href: localizedPath('/faq/', locale) },
      { label: t.footer.contact, href: localizedPath('/contact/', locale) },
      { label: t.footer.privacy, href: localizedPath('/privacy/', locale) },
      { label: t.footer.terms, href: localizedPath('/terms/', locale) },
    ],
  },
];
---

<footer class="border-t border-line bg-surface">
  <div class="container-wide grid gap-12 py-16 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="max-w-[38ch]">
      <a href={homePath(locale)} class="flex items-center gap-2.5 text-lg font-bold tracking-tight">
        <img src="/assets/images/voice-rep-logo.png" alt="" width="36" height="36" class="h-9 w-9 object-contain" />
        <span class="font-display">Voice Rep Counter</span>
      </a>
      <p class="mt-4 text-sm text-muted">{t.footer.tagline}</p>
      <div class="mt-6">
        <StoreBadges locale={locale} />
      </div>
    </div>

    {
      groups.map((group) => (
        <nav aria-label={group.title}>
          <h2 class="text-sm font-semibold uppercase tracking-wider text-muted">{group.title}</h2>
          <ul class="mt-4 grid gap-3">
            {
              group.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted-strong transition-colors hover:text-accent">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="border-t border-line">
    <div class="container-wide flex flex-col gap-3 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} {SITE.legalOwner}. {t.footer.rights}
      </p>
      <p>{t.footer.legalReviewNote}</p>
    </div>
  </div>
</footer>
