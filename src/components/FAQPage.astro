---
import { faqPage } from '../data/faq';
import { type Locale } from '../data/site';
import Breadcrumbs from './Breadcrumbs.astro';
import FAQList from './FAQList.astro';
import FinalCTA from './FinalCTA.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = faqPage[locale];
---

<article>
  <div class="border-b border-line">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs locale={locale} items={[{ name: c.h1 }]} />
      <h1 class="text-balance text-center text-4xl font-bold sm:text-5xl">{c.h1}</h1>
      <p class="mt-6 text-center text-lg text-muted-strong">{c.lead}</p>
    </div>
  </div>

  <div class="container-wide py-14 sm:py-20">
    <div class="mx-auto grid max-w-[1120px] items-start gap-6 md:grid-cols-2">
      <FAQList items={c.faq.slice(0, Math.ceil(c.faq.length / 2))} />
      <FAQList items={c.faq.slice(Math.ceil(c.faq.length / 2))} />
    </div>
  </div>
</article>

<FinalCTA locale={locale} />
