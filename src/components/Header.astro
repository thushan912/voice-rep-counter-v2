---
import { getUI } from '../i18n/ui';
import { homePath, localizedPath } from '../i18n/routes';
import { SITE, type Locale } from '../data/site';
import StoreBadges from './StoreBadges.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = getUI(locale);
const home = homePath(locale);

const navItems = [
  { label: t.nav.features, href: localizedPath('/features/', locale) },
  { label: t.nav.howItWorks, href: localizedPath('/how-it-works/', locale) },
  { label: t.nav.exercises, href: localizedPath('/exercises/', locale) },
  { label: t.nav.blog, href: localizedPath('/blog/', locale) },
  { label: t.nav.faq, href: localizedPath('/faq/', locale) },
];

const localeLinks = [
  { code: 'en', label: 'EN', href: localizedPath(currentPath, 'en') },
  { code: 'it', label: 'IT', href: localizedPath(currentPath, 'it') },
];

function isActive(href: string): boolean {
  if (href === home) return currentPath === home;
  return currentPath === href || currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <div class="container-wide flex h-[72px] items-center justify-between gap-6">
    <a href={home} class="flex shrink-0 items-center gap-2 text-lg font-bold tracking-tight" aria-label={SITE.name}>
      <span aria-hidden="true" class="inline-block h-2.5 w-2.5 rounded-full bg-accent"></span>
      <span class="font-display">Voice Rep Counter</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive(item.href) ? 'text-accent' : 'text-muted-strong hover:text-ink'
            }`}
          >
            {item.label}
          </a>
        ))
      }

      <div class="ml-2 flex items-center gap-1 rounded-lg border border-line bg-surface px-1 py-1" aria-label="Language">
        {
          localeLinks.map((link) => (
            <a
              href={link.href}
              lang={link.code}
              hreflang={link.code}
              aria-current={link.code === locale ? 'true' : undefined}
              class={`rounded-md px-2 py-1 text-xs font-semibold transition-colors ${
                link.code === locale ? 'bg-accent text-accent-on' : 'text-muted hover:text-ink'
              }`}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <a href="#download" class="btn btn-primary ml-2">{t.nav.download}</a>
    </nav>

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line bg-surface text-ink lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      aria-label={t.nav.menuOpen}
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-line bg-bg lg:hidden">
    <nav class="container-wide flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`rounded-lg px-3 py-3 text-base font-medium transition-colors ${
              isActive(item.href) ? 'bg-surface text-accent' : 'text-muted-strong hover:bg-surface hover:text-ink'
            }`}
          >
            {item.label}
          </a>
        ))
      }

      <div class="my-3 flex items-center gap-2 border-y border-line py-3" aria-label="Language">
        {
          localeLinks.map((link) => (
            <a
              href={link.href}
              lang={link.code}
              hreflang={link.code}
              aria-current={link.code === locale ? 'true' : undefined}
              class={`rounded-md px-4 py-2 text-sm font-semibold ${
                link.code === locale ? 'bg-accent text-accent-on' : 'bg-surface text-muted-strong'
              }`}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="py-2">
        <StoreBadges locale={locale} />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    menu.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1024) setOpen(false);
    });
  }
</script>
