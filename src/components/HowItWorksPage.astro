---
import { howItWorks } from '../data/howItWorks';
import { type Locale } from '../data/site';
import Breadcrumbs from './Breadcrumbs.astro';
import HowItWorksShowcase from './HowItWorksShowcase.astro';
import FinalCTA from './FinalCTA.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = howItWorks[locale];
---

<article>
  <div class="border-b border-line">
    <div class="container-wide py-10 sm:py-14">
      <Breadcrumbs locale={locale} items={[{ name: c.h1 }]} />
      <h1 class="text-balance max-w-[22ch] text-4xl font-bold sm:text-5xl">{c.h1}</h1>
      <p class="mt-6 max-w-[64ch] text-lg text-muted-strong">{c.lead}</p>
    </div>
  </div>

  <!-- Workflow summary cards -->
  <div class="container-wide py-10 sm:py-14">
    <div class="grid gap-4 md:grid-cols-3">
      {
        c.cards.map((card, index) => (
          <a href={`#${card.anchor}`} class="card group p-7 transition-colors hover:border-accent">
            <span class="font-display text-4xl font-bold text-accent">{String(index + 1).padStart(2, '0')}</span>
            <h2 class="mt-4 text-xl font-semibold text-ink transition-colors group-hover:text-accent">{card.title}</h2>
            <p class="mt-2 text-muted-strong">{card.description}</p>
            <span class="mt-5 inline-block font-semibold text-accent">↓</span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- Premium visual walkthrough -->
  <div class="border-t border-line">
    {
      c.sections.map((section, index) => (
        <HowItWorksShowcase locale={locale} section={section} index={index} />
      ))
    }
  </div>
</article>

<FinalCTA locale={locale} />
