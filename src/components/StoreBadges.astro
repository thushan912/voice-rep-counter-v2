---
import { APP_LINKS, type Locale } from '../data/site';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' } = Astro.props;

const labels =
  locale === 'it'
    ? { google: 'Disponibile su Google Play', apple: 'Scarica su App Store' }
    : { google: 'Get it on Google Play', apple: 'Download on the App Store' };
---

<div class={`flex flex-wrap items-center gap-3 ${className}`}>
  <a
    href={APP_LINKS.googlePlay}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels.google}
    class="inline-flex items-center transition-transform hover:-translate-y-0.5"
  >
    <img
      src="/assets/brand/google.svg"
      alt={labels.google}
      width="157"
      height="48"
      loading="lazy"
      decoding="async"
    />
  </a>
  <a
    href={APP_LINKS.appStore}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={labels.apple}
    class="inline-flex items-center transition-transform hover:-translate-y-0.5"
  >
    <img
      src="/assets/brand/apple.svg"
      alt={labels.apple}
      width="157"
      height="48"
      loading="lazy"
      decoding="async"
    />
  </a>
</div>
