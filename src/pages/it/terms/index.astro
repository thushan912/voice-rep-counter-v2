---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegalPage from '../../../components/LegalPage.astro';
import { terms } from '../../../data/legal';

const locale = 'it';
const c = terms.it;
---

<BaseLayout locale={locale} title={c.metaTitle} description={c.metaDescription} path="/it/terms/">
  <LegalPage locale={locale} content={c} />
</BaseLayout>
