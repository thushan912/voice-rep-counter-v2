import FeaturesOverviewPage from '../../components/FeaturesOverviewPage.astro';
import { featuresOverview } from '../../data/features';

const locale = 'en';
const overview = featuresOverview.en;
---

<BaseLayout locale={locale} title={overview.metaTitle} description={overview.metaDescription} path="/features/">
