---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { privacy } from '../../data/legal';

const locale = 'en';
const c = privacy.en;
---

<BaseLayout locale={locale} title={c.metaTitle} description={c.metaDescription} path="/privacy/">
  <LegalPage locale={locale} content={c} />
</BaseLayout>
