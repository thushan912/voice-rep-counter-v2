---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadges from '../components/StoreBadges.astro';

const locale = 'en';
---

<BaseLayout
  locale={locale}
  title="Page not found | Voice Rep Counter"
  description="The page you are looking for could not be found. Return to the Voice Rep Counter homepage."
  path="/404/"
  noindex
>
  <section class="border-b border-line">
    <div class="container-wide py-24 text-center sm:py-32">
      <p class="eyebrow justify-center">Error 404</p>
      <h1 class="mt-4 text-5xl font-bold sm:text-6xl">Page not found</h1>
      <p class="mx-auto mt-5 max-w-[52ch] text-lg text-muted-strong">
        The page you are looking for does not exist or has moved.
      </p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">Back to homepage</a>
        <a href="/it/" class="btn btn-secondary">Vai alla home in italiano</a>
      </div>
      <div class="mt-10 flex justify-center">
        <StoreBadges locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
